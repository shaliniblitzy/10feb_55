# ============================================================
# GAE-GNP Facultativo — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
#
# This template documents all environment variables required
# by the Python/Flask rewrite of the GAE-GNP Facultativo
# microservice platform. It replaces hardcoded configuration
# values from the original Java application.yml and
# application-test.yml files.
#
# See also: config/application.yml for YAML-based defaults.
# ============================================================

# ------------------------------------------------------------
# Flask Configuration
# ------------------------------------------------------------
# Application environment: development, testing, production
FLASK_ENV=development

# HTTP server port (default: 8080, matching Google App Engine standard)
FLASK_PORT=8080

# Secret key for Flask session signing and CSRF protection.
# CRITICAL: Change this to a long, random string in production.
# Replaces Spring Security session management key.
FLASK_SECRET_KEY=change-me-to-a-secure-random-value

# ------------------------------------------------------------
# gRPC Server Configuration
# ------------------------------------------------------------
# gRPC server port for inter-service communication between
# the six application modules (administrador, catalogos,
# procesos, reportes, sincronizador-archivos, tarifas).
# Default: 50051 (standard gRPC port)
GRPC_PORT=50051

# ------------------------------------------------------------
# Apigee API Gateway Authentication
# ------------------------------------------------------------
# CRITICAL: This replaces the hardcoded Apigee tokens found in
# the original Java application.yml files (Modules 1, 3, 5).
# Per AAP Section 0.7.3: No Hardcoded Secrets — this token
# must be injected at runtime via environment variable or
# GCP Secret Manager.
#
# Used for Layer 1 authentication: Apigee gateway validates
# this token on all external-facing endpoints (administrador,
# procesos, sincronizador-archivos blueprints).
APIGEE_TOKEN=your-apigee-token-here

# ------------------------------------------------------------
# Google Cloud Platform Configuration
# ------------------------------------------------------------
# Google Cloud project identifier for Secret Manager and
# other GCP services used by the application.
GCP_PROJECT_ID=your-gcp-project-id

# Toggle for GCP Secret Manager credential resolution.
# Set to "true" in production to resolve secrets from
# GCP Secret Manager. Set to "false" in development to
# use environment variables directly.
SECRET_MANAGER_ENABLED=false

# ------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------
# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Replaces the Logback Classic 1.5.18 + Log4j API 2.25.0
# dual logging stack from the original Java application.
LOG_LEVEL=INFO

# Gunicorn WSGI server log level (debug, info, warning, error, critical).
# Controls access and error logging for the production server
# that replaces the original embedded Apache Tomcat 10.1.41.
GUNICORN_LOG_LEVEL=info

# Number of Gunicorn worker processes for handling HTTP requests.
# Recommended: (2 * CPU_CORES) + 1 for production deployments.
GUNICORN_WORKERS=4
